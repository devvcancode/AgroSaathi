{
  "name": "AgroVani Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "npm ci && python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "forwardPorts": [3000, 5000, 8787],
  "portsAttributes": {
    "5000": {
      "label": "AgroVani Yield API",
      "onAutoForward": "openBrowser"
    },
    "3000": {
      "label": "AgroVani Web App"
    },
    "8787": {
      "label": "AgroVani Location WebSocket"
    }
  }
}
