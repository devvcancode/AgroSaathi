# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
DISABLE_PWA=true
CORS_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Production OAuth callback: https://YOUR_VERCEL_DOMAIN/api/auth/callback/google
# Render callback, if OAuth is served by the Render web service:
# https://YOUR_RENDER_DOMAIN/api/auth/callback/google

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrosaathi
MONGO_URL=
DB_NAME=agrovani

# Optional production service URLs
YIELD_MODEL_API_URL=http://localhost:5000/predict
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_LOCATION_WS_URL=ws://localhost:8787
LOCATION_WS_PORT=8787

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=Tiles &copy; Esri

# Agriculture and AI providers
AGMARKNET_SOURCE_URL=https://agmarknet.gov.in/
GOVT_MANDI_API_URL=
GOVT_MANDI_API_KEY=
METEOBLUE_APIKEY=
CEHUB_APIKEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash

# Optional Google Cloud Vertex AI matchmaking
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_ENDPOINT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Redis
REDIS_URL=redis://localhost:6379

# Optional LiveKit, payments, translation, satellite and monitoring providers
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
ISRO_SATELLITE_API_URL=
ISRO_SATELLITE_API_KEY=

# Mock external verification services
KISAAN_ID_API_URL=https://mock.gov.in/kisaan/verify
COMPANY_REGISTRY_API_URL=https://mock.registry.gov/company/verify

# Optional
NEXT_PUBLIC_APP_NAME=AgroSaathi
