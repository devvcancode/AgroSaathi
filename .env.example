# Vercel / application
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=
CORS_ORIGINS=*
YIELD_MODEL_API_URL=http://localhost:5000/predict
NEXT_PUBLIC_LOCATION_WS_URL=ws://localhost:8787
LOCATION_WS_PORT=8787
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=Tiles &copy; Esri

# Razorpay subscriptions / plan checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Driver navigation map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Advisory data. Demo rows are clearly labeled until an official feed is configured.
AGMARKNET_SOURCE_URL=https://agmarknet.gov.in/
ADVISORY_DB_PATH=./data/agrovani.sqlite

# Primary production database: Supabase
# Add the real values in .env.local or Vercel Project Settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for server-side Supabase writes; never expose this as NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional local MongoDB fallback
MONGO_URL=mongodb://localhost:27017
DB_NAME=agrovani

# External data services
METEOBLUE_APIKEY=your-meteoblue-api-key
CEHUB_APIKEY=
GOVT_MANDI_API_URL=https://api.data.gov.in/resource/your-resource-id
GOVT_MANDI_API_KEY=your-data-gov-in-api-key
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
ISRO_SATELLITE_API_URL=
ISRO_SATELLITE_API_KEY=

# India live weather map. Configure the Cloud Next Weather V3 endpoint when available.
CLOUD_NEXT_WEATHER_API_URL=
CLOUD_NEXT_WEATHER_API_KEY=
CLOUD_NEXT_WEATHER_API_VERSION=v3

# Gemini free-tier voice assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional low-latency Gemini Live agent through LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Aoede

# Automated Matchmaking AI
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_ENDPOINT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
