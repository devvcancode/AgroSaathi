# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
DISABLE_PWA=true
CORS_ORIGINS=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Production OAuth callback: https://YOUR_VERCEL_DOMAIN/api/auth/callback/google
# Render callback, if OAuth is served by the Render web service:
# https://YOUR_RENDER_DOMAIN/api/auth/callback/google

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrosaathi
MONGO_URL=
DB_NAME=agrovani
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional production service URLs
YIELD_MODEL_API_URL=http://localhost:5000/predict
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_LOCATION_WS_URL=ws://localhost:8787
LOCATION_WS_URL=ws://localhost:8787
LOCATION_WS_PORT=8787

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=Tiles &copy; Esri

# Agriculture and AI providers
METEOBLUE_APIKEY=
CEHUB_APIKEY=
CLOUD_NEXT_WEATHER_API_URL=
CLOUD_NEXT_WEATHER_API_KEY=
CLOUD_NEXT_WEATHER_API_VERSION=v3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
BHASHINI_ASR_ENDPOINT=
BHASHINI_ASR_INFERENCE_KEY=
BHASHINI_TTS_ENDPOINT=
BHASHINI_TTS_INFERENCE_KEY=

# DigiLocker OAuth consent (authorization only; KYC document review is separate)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/verification/digilocker/callback
DIGILOCKER_AUTH_URL=https://api.digitallocker.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://api.digitallocker.gov.in/public/oauth2/1/token

# Optional provider integrations
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
ISRO_SATELLITE_API_URL=
ISRO_SATELLITE_API_KEY=
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_ENDPOINT_ID=

# Optional service-account file path for local Vertex AI use; prefer workload identity in production
GOOGLE_APPLICATION_CREDENTIALS=

# Redis
REDIS_URL=redis://localhost:6379

# Mock external verification services
KISAAN_ID_API_URL=https://mock.gov.in/kisaan/verify
COMPANY_REGISTRY_API_URL=https://mock.registry.gov/company/verify

# Optional
NEXT_PUBLIC_APP_NAME=AgroSaathi
