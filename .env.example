# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Production OAuth callback: https://YOUR_VERCEL_DOMAIN/api/auth/callback/google
# Render callback, if OAuth is served by the Render web service:
# https://YOUR_RENDER_DOMAIN/api/auth/callback/google

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrosaathi

# Optional production service URLs
YIELD_MODEL_API_URL=http://localhost:5000/predict
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

# Mock external verification services
KISAAN_ID_API_URL=https://mock.gov.in/kisaan/verify
COMPANY_REGISTRY_API_URL=https://mock.registry.gov/company/verify

# Optional
NEXT_PUBLIC_APP_NAME=AgroSaathi
